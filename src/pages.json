{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^uv-(.*)": "@climblee/uv-ui/components/uv-$1/uv-$1.vue"
		}
	},
	"pages": [
		{
			"path": "pages/tabBar/index/index",
			"style": {
				"navigationBarTitleText": "自治区二次补偿信息服务",
				"enablePullDownRefresh": false,
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/tabBar/user/user",
			"style": {
				"navigationBarTitleText": "个人中心",
				"navigationStyle": "custom"
			}
		}
	],
	"subPackages": [
		{
			"root": "pages/subpackage",
			"pages": [
				{
					"path": "record/record",
					"style": {
						"navigationBarTitleText": "备案信息"
					}
				},
				{
					"path": "evaluate/evaluate",
					"style": {
						"navigationBarTitleText": "我的评价",
						"enablePullDownRefresh": true
					}
				},
				{
					"path": "questionnaire/questionnaire",
					"style": {
						"navigationBarTitleText": "我的问卷",
						"navigationStyle": "custom"
					}
				},
				{
					"path": "reservation/reservation",
					"style": {
						"navigationBarTitleText": "预约记录",
						"enablePullDownRefresh": true
					}
				},
				{
					"path": "physicalExamination/physicalExamination",
					"style": {
						"navigationBarTitleText": "健康体检服务记录",
						"enablePullDownRefresh": true
					}
				},
				{
					"path": "dynamicNews/dynamicNews",
					"style": {
						"navigationBarTitleText": "动态新闻",
						"enablePullDownRefresh": true
					}
				},
				{
					"path": "newsDetail/newsDetail",
					"style": {
						"navigationBarTitleText": "新闻详情",
						"enablePullDownRefresh": true
					}
				},
				{
					"path": "appointment/appointment",
					"style": {
						"navigationBarTitleText": "预约"
					}
				},
				{
					"path": "thridParty/thridParty",
					"style": {
						"navigationBarTitleText": "第三方页面"
					}
				},
				{
					"path": "login/login",
					"style": {
						"navigationBarTitleText": "用户登录"
					}
				}
			]
		}
	],
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "二次补偿",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8"
	},

	"tabBar": {
		"color": "#625B5F",
		"selectedColor": "#E54C16",
		"borderStyle": "black",
		"backgroundColor": "#F8F8F8",
		"list": [
			{
				"pagePath": "pages/tabBar/index/index",
				"iconPath": "static/tabbar/home.png",
				"selectedIconPath": "static/tabbar/home_selected.png",
				"text": "首页"
			},
			{
				"pagePath": "pages/tabBar/user/user",
				"iconPath": "static/tabbar/mine.png",
				"selectedIconPath": "static/tabbar/mine_selected.png",
				"text": "个人中心"
			}
		]
	}
}
